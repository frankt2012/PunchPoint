    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PunchPoint.Clock</RootNamespace>
    <AssemblyName>PunchPointClock</AssemblyName>
    <ApplicationManifest>..\PunchPoint.App\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\PunchPoint.App\Resources\punchpoint.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
